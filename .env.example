# Node job settings. Worker development reads .dev.vars instead.
AI_GATEWAY_API_KEY=
ADMIN_TOKEN=
PREFERENCES_SIGNING_SECRET=
PUBLIC_SITE_URL=http://localhost:3000

# Node jobs default to local storage only when --local is supplied.
# R2 credentials are required for Node jobs without --local.
R2_ACCOUNT_ID=
R2_BUCKET=forwardpass-example-issues
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Delivery and health alerts. Use your own verified sender and opted-in audience.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
NEWSLETTER_FROM="Example Briefing <news@yourdomain.com>"
NEWSLETTER_REPLY_TO=
ALERT_EMAIL=
FORWARDPASS_AUTOPUBLISH=false
FORWARDPASS_EDITORIAL_AUTOPUBLISH=false
FORWARDPASS_COMPUTE_ENABLED=true
FORWARDPASS_PERSONAL_EDITIONS_ENABLED=false
FORWARDPASS_WEEKLY_ENABLED=false
FORWARDPASS_COMPUTE_WEEKLY_ENABLED=false
FORWARDPASS_SIGNALS_ENABLED=false
FORWARDPASS_FAST_LANE_ENABLED=false

# Optional gateway model overrides; leave empty to use the defaults.
TRIAGE_MODEL=
FACTS_MODEL=
EDITOR_MODEL=
WRITER_MODEL=
CHECK_MODEL=
SIGNALS_MODEL=
JEV_MODEL=
IMAGE_MODEL=
TYPESAFE_API_KEY=

# Optional collection credentials and discovery notification.
GITHUB_TOKEN=
HF_TOKEN=
INDEXNOW_KEY=

# Optional agent credit payments. Configure your own Polar product.
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_AGENT_CREDITS=
POLAR_OFF_SESSION_ENABLED=false

# Optional provider registration and chat delivery.
CHAT_BACKEND_URL=
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_ENCRYPTION_KEY=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_APP_TENANT_ID=
TEAMS_APP_TYPE=SingleTenant
TEAMS_PACKAGE_ID=
